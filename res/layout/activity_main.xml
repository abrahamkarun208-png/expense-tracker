<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/ink" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_sub"
            android:textSize="12sp"
            android:textColor="@color/muted"
            android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/permNotice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:text="@string/perm_needed"
            android:textSize="13sp"
            android:padding="12dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/card" />

        <Button
            android:id="@+id/permButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:layout_marginTop="8dp"
            android:text="@string/grant"
            android:background="@drawable/btn_primary"
            android:textColor="#FFFFFF" />

        <!-- Hero total card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/hero_card"
            android:padding="20dp"
            android:layout_marginTop="14dp">

            <TextView
                android:id="@+id/totalLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Spent today"
                android:textSize="13sp"
                android:textColor="#CDE3D4" />

            <TextView
                android:id="@+id/totalView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹0"
                android:textSize="38sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/txnCountView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 transactions"
                android:textSize="12sp"
                android:textColor="#CDE3D4"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/incomeView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Income ₹0"
                android:textSize="14sp"
                android:textColor="#CDE3D4"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/netView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Net ₹0"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/overView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:textSize="13sp"
                android:textColor="#FFB4B4"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/pctView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:textSize="12sp"
                android:textColor="#CDE3D4"
                android:layout_marginTop="6dp" />

            <TextView
                android:id="@+id/duesView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:textSize="12sp"
                android:textColor="#CDE3D4"
                android:layout_marginTop="6dp" />
        </LinearLayout>

        <!-- Period tabs -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/tab_bar"
            android:padding="4dp"
            android:layout_marginTop="14dp">

            <Button
                android:id="@+id/btnDay"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/tab_daily"
                android:textSize="12sp"
                android:background="@drawable/tab_selected"
                android:textColor="#FFFFFF"
                android:minHeight="0dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp" />

            <Button
                android:id="@+id/btnWeek"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/tab_weekly"
                android:textSize="12sp"
                android:background="@null"
                android:textColor="@color/ink"
                android:minHeight="0dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp" />

            <Button
                android:id="@+id/btnMonth"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/tab_monthly"
                android:textSize="12sp"
                android:background="@null"
                android:textColor="@color/ink"
                android:minHeight="0dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp" />

            <Button
                android:id="@+id/btnCal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/tab_calendar"
                android:textSize="12sp"
                android:background="@null"
                android:textColor="@color/ink"
                android:minHeight="0dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp" />
        </LinearLayout>

        <!-- Spending breakdown (weekly / monthly) -->
        <LinearLayout
            android:id="@+id/pieCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:background="@drawable/card"
            android:padding="16dp"
            android:layout_marginTop="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Where your money went"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/ink" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">

                <com.local.expensetracker.PieChartView
                    android:id="@+id/pieChart"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <LinearLayout
                    android:id="@+id/pieLegend"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Calendar (calendar tab only) -->
        <LinearLayout
            android:id="@+id/calCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:background="@drawable/card"
            android:padding="8dp"
            android:layout_marginTop="12dp">

            <com.local.expensetracker.SpendCalendarView
                android:id="@+id/spendCal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical|center_horizontal"
                android:layout_marginTop="4dp">

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/dot_over" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" over \u20B91,500"
                    android:textSize="11sp"
                    android:textColor="@color/muted" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="     " />

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/dot_under" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" under \u20B91,500"
                    android:textSize="11sp"
                    android:textColor="@color/muted" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="     " />

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/dot_income" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" income"
                    android:textSize="11sp"
                    android:textColor="@color/muted" />
            </LinearLayout>
        </LinearLayout>

        <TextView style="@style/SectionHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/transactions" />

        <LinearLayout
            android:id="@+id/txnContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/emptyTxns"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:text="@string/no_txns"
            android:textSize="13sp"
            android:textColor="@color/muted"
            android:padding="16dp" />

        <TextView style="@style/SectionHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cards" />

        <LinearLayout
            android:id="@+id/dueContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/emptyDues"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:text="@string/no_dues"
            android:textSize="13sp"
            android:textColor="@color/muted"
            android:padding="16dp" />

        <Button
            android:id="@+id/rescan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="8dp"
            android:text="@string/rescan"
            android:background="@drawable/btn_primary"
            android:textColor="#FFFFFF" />

        <TextView
            android:id="@+id/appVersion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="© 2026 Chris"
            android:textSize="11sp"
            android:textColor="@color/muted"
            android:gravity="center"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/checkUpdates"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Check for updates"
            android:textSize="11sp"
            android:textColor="@color/primary"
            android:padding="8dp"
            android:layout_marginBottom="4dp" />
    </LinearLayout>
</ScrollView>
