<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Expense Tracker"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/ink" />

        <!-- Month navigator: drives the NET card, Month tab and Calendar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="10dp">

            <TextView
                android:id="@+id/monthPrev"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:gravity="center"
                android:text="&#8249;"
                android:textSize="28sp"
                android:textColor="@color/muted" />

            <TextView
                android:id="@+id/monthTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="October 2026"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/ink" />

            <TextView
                android:id="@+id/monthNext"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:gravity="center"
                android:text="&#8250;"
                android:textSize="28sp"
                android:textColor="@color/muted" />
        </LinearLayout>

        <!-- NET hero card -->
        <LinearLayout
            android:id="@+id/netCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/hero_card"
            android:padding="20dp"
            android:layout_marginTop="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/netLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="NET THIS MONTH"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/muted" />

                <TextView
                    android:id="@+id/netAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+&#8377;0"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:textColor="@color/credit" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="14dp">

                <LinearLayout
                    android:id="@+id/tileIncome"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/tile_income"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="&#8593; INCOME"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/credit" />

                    <TextView
                        android:id="@+id/incomeTileAmt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="&#8377;0"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="@color/credit"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

                <Space
                    android:layout_width="12dp"
                    android:layout_height="wrap_content" />

                <LinearLayout
                    android:id="@+id/tileExpense"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="@drawable/tile_expense"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="&#8595; EXPENSES"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/debit" />

                    <TextView
                        android:id="@+id/expenseTileAmt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="&#8377;0"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="@color/debit"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/netBar"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:orientation="horizontal"
                android:layout_marginTop="14dp">

                <View
                    android:id="@+id/netBarFill"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="0"
                    android:background="@color/debit" />

                <View
                    android:id="@+id/netBarRest"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="100"
                    android:background="@color/bar_track" />
            </LinearLayout>

            <TextView
                android:id="@+id/pctCaption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="@color/muted"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/duesLine"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:textSize="12sp"
                android:textColor="@color/muted"
                android:layout_marginTop="6dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/permNotice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:text="@string/perm_needed"
            android:textSize="13sp"
            android:padding="12dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/card" />

        <Button
            android:id="@+id/permButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:layout_marginTop="8dp"
            android:text="@string/grant"
            android:background="@drawable/btn_primary"
            android:textColor="#0F1712" />

        <!-- Period tabs with underline indicator -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp">

            <LinearLayout
                android:id="@+id/tabDay"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingTop="8dp"
                android:paddingBottom="4dp">

                <TextView
                    android:id="@+id/tabDayText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Day"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/ink" />

                <View
                    android:id="@+id/tabDayInd"
                    android:layout_width="36dp"
                    android:layout_height="3dp"
                    android:layout_marginTop="6dp"
                    android:background="@color/primary" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tabWeek"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingTop="8dp"
                android:paddingBottom="4dp">

                <TextView
                    android:id="@+id/tabWeekText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Week"
                    android:textSize="15sp"
                    android:textColor="@color/muted" />

                <View
                    android:id="@+id/tabWeekInd"
                    android:layout_width="36dp"
                    android:layout_height="3dp"
                    android:layout_marginTop="6dp"
                    android:background="@color/primary"
                    android:visibility="invisible" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tabMonth"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingTop="8dp"
                android:paddingBottom="4dp">

                <TextView
                    android:id="@+id/tabMonthText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Month"
                    android:textSize="15sp"
                    android:textColor="@color/muted" />

                <View
                    android:id="@+id/tabMonthInd"
                    android:layout_width="36dp"
                    android:layout_height="3dp"
                    android:layout_marginTop="6dp"
                    android:background="@color/primary"
                    android:visibility="invisible" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tabCal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingTop="8dp"
                android:paddingBottom="4dp">

                <TextView
                    android:id="@+id/tabCalText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Calendar"
                    android:textSize="15sp"
                    android:textColor="@color/muted" />

                <View
                    android:id="@+id/tabCalInd"
                    android:layout_width="36dp"
                    android:layout_height="3dp"
                    android:layout_marginTop="6dp"
                    android:background="@color/primary"
                    android:visibility="invisible" />
            </LinearLayout>
        </LinearLayout>

        <!-- Spending breakdown (weekly / monthly) -->
        <LinearLayout
            android:id="@+id/pieCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:background="@drawable/card"
            android:padding="16dp"
            android:layout_marginTop="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Where your money went"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/ink" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">

                <com.local.expensetracker.PieChartView
                    android:id="@+id/pieChart"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <LinearLayout
                    android:id="@+id/pieLegend"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Calendar (calendar tab only) -->
        <LinearLayout
            android:id="@+id/calCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:background="@drawable/card"
            android:padding="8dp"
            android:layout_marginTop="12dp">

            <com.local.expensetracker.SpendCalendarView
                android:id="@+id/spendCal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical|center_horizontal"
                android:layout_marginTop="4dp">

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/dot_over" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" over \u20B91,500"
                    android:textSize="11sp"
                    android:textColor="@color/muted" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="     " />

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/dot_under" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" under \u20B91,500"
                    android:textSize="11sp"
                    android:textColor="@color/muted" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="     " />

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/dot_income" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" income"
                    android:textSize="11sp"
                    android:textColor="@color/muted" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/txnContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/emptyTxns"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:text="@string/no_txns"
            android:textSize="13sp"
            android:textColor="@color/muted"
            android:padding="16dp" />

        <TextView style="@style/SectionHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cards" />

        <LinearLayout
            android:id="@+id/dueContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/emptyDues"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:text="@string/no_dues"
            android:textSize="13sp"
            android:textColor="@color/muted"
            android:padding="16dp" />

        <Button
            android:id="@+id/rescan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="8dp"
            android:text="@string/rescan"
            android:background="@drawable/btn_primary"
            android:textColor="#0F1712" />

        <TextView
            android:id="@+id/appVersion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="© 2026 Chris"
            android:textSize="11sp"
            android:textColor="@color/muted"
            android:gravity="center"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/checkUpdates"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Check for updates"
            android:textSize="11sp"
            android:textColor="@color/primary"
            android:padding="8dp"
            android:layout_marginBottom="4dp" />
    </LinearLayout>
</ScrollView>
